   "text": "Plano de control: la compuerta es el replay al 100 % contra el corpus.",
   "originalText": "Plano de control: la compuerta es el replay al 100 % contra el corpus.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
